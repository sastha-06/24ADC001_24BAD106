          <datasource-dependencies datasource='federated.1nhe2pf1kaif9v1d95sa4117igzt'>
            <column caption='Death Percentage of Population' datatype='real' name='[Calculation_1435989963108355]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [population] = 0 OR ISNULL([population]) THEN&#13;&#10;0&#13;&#10;ELSE&#13;&#10;([total_deaths] / [population]) * 100&#13;&#10;END' />
            </column>
            <column caption='Population' datatype='real' name='[population]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1435989963108355]' derivation='Sum' name='[sum:Calculation_1435989963108355:qk]' pivot='key' type='quantitative' />
