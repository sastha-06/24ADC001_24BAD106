      <aliases enabled='yes' />
      <column caption='Sales null check' datatype='boolean' name='[Calculation_0126194622914560]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ISNULL([Category])' />
      </column>
      <column caption='Profit null check' datatype='boolean' name='[Calculation_0126194625744897]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ISNULL([Profit])' />
      </column>
      <column caption='Category null check' datatype='boolean' name='[Calculation_0126194626228229]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ISNULL([Category])' />
      </column>
      <column caption='Region null check' datatype='boolean' name='[Calculation_0126194627817478]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ISNULL([Region])' />
      </column>
      <column caption='Sales Clean' datatype='integer' datatype-customized='true' name='[Calculation_0126194632970247]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(IFNULL([Sales], { FIXED : AVG([Sales]) }))' />
      </column>
      <column caption='Profit Clean' datatype='integer' datatype-customized='true' name='[Calculation_0126194634010632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(IFNULL([Profit], { FIXED : AVG([Profit]) }))' />
      </column>
      <column aggregate-role-from='[State]' caption='Region Clean' datatype='string' name='[Calculation_0126194634620937]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Region]) THEN&#13;&#10;&quot;Unknown&quot;&#13;&#10;ELSE&#13;&#10;PROPER(TRIM([Region]))&#13;&#10;END' />
      </column>
      <column caption='Category Clean' datatype='string' name='[Calculation_0126194634887178]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([Category], &quot;Unknown&quot;)' />
      </column>
      <column caption='Sales Capped' datatype='integer' name='[Calculation_0126194638675979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Sales] &gt; 10000 THEN&#13;&#10;10000&#13;&#10;ELSE&#13;&#10;[Sales]&#13;&#10;END' />
      </column>
      <column caption='Outlier Flag' datatype='string' name='[Calculation_0126194639212556]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Sales] &gt; 10000 THEN&#13;&#10;&quot;Outlier&quot;&#13;&#10;ELSE&#13;&#10;&quot;Normal&quot;&#13;&#10;END' />
      </column>
      <column caption='Profit capped' datatype='integer' name='[Calculation_0126194642083853]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Profit] &gt; 10000 THEN&#13;&#10;10000&#13;&#10;ELSE&#13;&#10;[Profit]&#13;&#10;END' />
      </column>
      <column caption='Selected KPI' datatype='integer' name='[Calculation_0769136451874816]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Sales&quot; THEN&#13;&#10;SUM([Calculation_0126194632970247])&#13;&#10;ELSE&#13;&#10;SUM([Calculation_0126194634010632])&#13;&#10;END' />
      </column>
      <column caption='Profit Margin %' datatype='real' name='[Calculation_0837306080546816]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Calculation_0126194632970247]) = 0 THEN&#13;&#10;0&#13;&#10;ELSE&#13;&#10;(SUM([Calculation_0126194634010632]) / SUM([Calculation_0126194632970247])) * 100&#13;&#10;END' />
